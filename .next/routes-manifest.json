{
  "version": 3,
  "pages404": true,
  "caseSensitive": false,
  "basePath": "",
  "redirects": [
    {
      "source": "/:path+/",
      "destination": "/:path+",
      "internal": true,
      "statusCode": 308,
      "regex": "^(?:/((?:[^/]+?)(?:/(?:[^/]+?))*))/$"
    },
    {
      "source": "/:match(tiquete|pagar|buscar|entrega|aprobar|app|admin|registro|mini-landing)\\.html",
      "destination": "/:match",
      "statusCode": 308,
      "regex": "^(?!/_next)(?:/(tiquete|pagar|buscar|entrega|aprobar|app|admin|registro|mini-landing))\\.html(?:/)?$"
    }
  ],
  "headers": [],
  "rewrites": {
    "beforeFiles": [],
    "afterFiles": [],
    "fallback": []
  },
  "dynamicRoutes": [],
  "staticRoutes": [
    {
      "page": "/",
      "regex": "^/(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/(?:/)?$"
    },
    {
      "page": "/_not-found",
      "regex": "^/_not\\-found(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/_not\\-found(?:/)?$"
    },
    {
      "page": "/admin",
      "regex": "^/admin(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/admin(?:/)?$"
    },
    {
      "page": "/aprobar",
      "regex": "^/aprobar(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/aprobar(?:/)?$"
    },
    {
      "page": "/buscar",
      "regex": "^/buscar(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/buscar(?:/)?$"
    },
    {
      "page": "/entrega",
      "regex": "^/entrega(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/entrega(?:/)?$"
    },
    {
      "page": "/pagar",
      "regex": "^/pagar(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/pagar(?:/)?$"
    },
    {
      "page": "/panel",
      "regex": "^/panel(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/panel(?:/)?$"
    },
    {
      "page": "/registro",
      "regex": "^/registro(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/registro(?:/)?$"
    },
    {
      "page": "/tiquete",
      "regex": "^/tiquete(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/tiquete(?:/)?$"
    }
  ],
  "dataRoutes": [],
  "rsc": {
    "header": "rsc",
    "varyHeader": "rsc, next-router-state-tree, next-router-prefetch, next-router-segment-prefetch",
    "prefetchHeader": "next-router-prefetch",
    "didPostponeHeader": "x-nextjs-postponed",
    "contentTypeHeader": "text/x-component",
    "suffix": ".rsc",
    "prefetchSuffix": ".prefetch.rsc",
    "prefetchSegmentHeader": "next-router-segment-prefetch",
    "prefetchSegmentSuffix": ".segment.rsc",
    "prefetchSegmentDirSuffix": ".segments"
  },
  "rewriteHeaders": {
    "pathHeader": "x-nextjs-rewritten-path",
    "queryHeader": "x-nextjs-rewritten-query"
  }
}